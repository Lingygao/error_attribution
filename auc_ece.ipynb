    "print(f\"Saved test single-signal age-group AUC: {OUTPUT_TEST_SINGLE_SIGNAL_AGE_GROUP_CSV.resolve()}\")\n",
    "print(f\"Saved test single-signal age-group variability: {OUTPUT_TEST_SINGLE_SIGNAL_AGE_VARIABILITY_CSV.resolve()}\")\n",
    "\n",
    "\n",
    "single_feature_rows = []\n",
    "for config in MODEL_CONFIGS:\n",
    "    model_version = config[\"model_version\"]\n",
    "    for task in TASK_COLS:\n",
    "        train_task = train_df[train_df[task].notna()].copy()\n",
    "        test_task = test_df[test_df[task].notna()].copy()\n",
    "        y_train = train_task[task].astype(int).to_numpy()\n",
    "        y_test = test_task[task].astype(int).to_numpy()\n",
    "        for feature in feature_cols:\n",
    "            row = {\n",
    "                \"model_version\": model_version,\n",
    "                \"C\": config[\"C\"],\n",
    "                \"class_weight\": config.get(\"class_weight\"),\n",
    "                \"task\": task,\n",
    "                \"feature\": feature,\n",
    "                \"n_train\": len(train_task),\n",
    "                \"n_test\": len(test_task),\n",
    "                \"auc\": np.nan,\n",
    "                \"ece\": np.nan,\n",
    "                \"status\": \"ok\",\n",
    "            }\n",
    "            if len(np.unique(y_train)) < 2:\n",
    "                row[\"status\"] = \"train_only_one_class\"\n",
    "                single_feature_rows.append(row)\n",
    "                continue\n",
    "            model = make_model(config)\n",
    "            model.fit(train_task[[feature]].to_numpy(dtype=float), y_train)\n",
    "            prob = model.predict_proba(test_task[[feature]].to_numpy(dtype=float))[:, 1]\n",
    "            row[\"auc\"] = binary_auc(y_test, prob)\n",
    "            row[\"ece\"] = expected_calibration_error(y_test, prob, n_bins=ECE_N_BINS)\n",
    "            if len(np.unique(y_test)) < 2:\n",
    "                row[\"status\"] = \"ok_but_test_auc_undefined_one_class\"\n",
    "            single_feature_rows.append(row)\n",
    "\n",
    "single_feature_logreg_df = pd.DataFrame(single_feature_rows).sort_values([\"model_version\", \"task\", \"auc\"], ascending=[True, True, False])\n",
    "display(single_feature_logreg_df)\n",
    "single_feature_logreg_df.to_csv(OUTPUT_SINGLE_FEATURE_LOGREG_CSV, index=False)\n",
    "print(f\"Saved single-feature logistic metrics: {OUTPUT_SINGLE_FEATURE_LOGREG_CSV.resolve()}\")\n",
    "\n",
    "\n",
    "coef_rows = []\n",
    "for (model_version, task), model in models.items():\n",
    "    for row in get_model_coefficients(model, feature_cols):\n",
    "        row[\"model_version\"] = model_version\n",
    "        row[\"task\"] = task\n",
    "        coef_rows.append(row)\n",
    "logreg_coefficients_df = pd.DataFrame(coef_rows).sort_values([\"model_version\", \"task\", \"feature\"])\n",
    "display(logreg_coefficients_df)\n",
    "logreg_coefficients_df.to_csv(OUTPUT_LOGREG_COEFFICIENTS_CSV, index=False)\n",
    "print(f\"Saved logistic coefficients: {OUTPUT_LOGREG_COEFFICIENTS_CSV.resolve()}\")"
