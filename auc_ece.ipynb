   "source": [
    "## 11. Age-group AUC/ECE variability\n",
    "\n",
    "This section computes AUC and ECE separately for each test `age_group`, then summarizes between-group variability as `auc_std` and `ece_std` for each task. Groups with only one class have undefined AUC but can still contribute ECE."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def metric_by_group(pred_df: pd.DataFrame, group_col: str = \"age_group\", n_bins: int = 10) -> pd.DataFrame:\n",
    "    if pred_df.empty:\n",
    "        return pd.DataFrame()\n",
    "    if group_col not in pred_df.columns:\n",
    "        print(f\"{group_col!r} not found in predictions; skipping group metric analysis.\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    rows = []\n",
    "    usable = pred_df.dropna(subset=[group_col]).copy()\n",
    "    if usable.empty:\n",
    "        print(f\"No predictions with non-missing {group_col}; skipping group metric analysis.\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    group_keys = [\"model_version\", \"task\", group_col] if \"model_version\" in usable.columns else [\"task\", group_col]\n",
    "    for keys, group in usable.groupby(group_keys, dropna=False, sort=True):\n",
    "        if \"model_version\" in usable.columns:\n",
    "            model_version, task, group_value = keys\n",
    "        else:\n",
    "            model_version = None\n",
    "            task, group_value = keys\n",
    "        y = group[\"y_true\"].to_numpy(dtype=float)\n",
    "        p = group[\"y_prob\"].to_numpy(dtype=float)\n",
    "        n_pos = int((y == 1).sum())\n",
    "        n_neg = int((y == 0).sum())\n",
    "        rows.append(\n",
    "            {\n",
    "                \"model_version\": model_version,\n",
    "                \"task\": task,\n",
    "                group_col: group_value,\n",
    "                \"n\": int(len(group)),\n",
    "                \"n_speakers\": int(group[TEST_SPEAKER_COL].nunique()) if TEST_SPEAKER_COL in group.columns else np.nan,\n",
    "                \"n_pos\": n_pos,\n",
    "                \"n_neg\": n_neg,\n",
    "                \"auc\": binary_auc(y, p),\n",
    "                \"ece\": expected_calibration_error(y, p, n_bins=n_bins),\n",
    "                \"auc_status\": \"ok\" if n_pos > 0 and n_neg > 0 else \"only_one_class\",\n",
    "            }\n",
    "        )\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def group_metric_variability(group_metrics: pd.DataFrame, group_col: str = \"age_group\") -> pd.DataFrame:\n",
    "    if group_metrics.empty:\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    rows = []\n",
    "    group_keys = [\"model_version\", \"task\"] if \"model_version\" in group_metrics.columns else [\"task\"]\n",
    "    for keys, group in group_metrics.groupby(group_keys, sort=True):\n",
    "        if \"model_version\" in group_metrics.columns:\n",
    "            model_version, task = keys\n",
    "        else:\n",
    "            model_version = None\n",
    "            task = keys[0] if isinstance(keys, tuple) else keys\n",
    "        auc_values = group[\"auc\"].dropna()\n",
    "        ece_values = group[\"ece\"].dropna()\n",
    "        rows.append(\n",
    "            {\n",
    "                \"model_version\": model_version,\n",
    "                \"task\": task,\n",
    "                \"n_groups\": int(group[group_col].nunique(dropna=True)),\n",
    "                \"n_groups_auc_defined\": int(auc_values.shape[0]),\n",
    "                \"n_groups_ece_defined\": int(ece_values.shape[0]),\n",
    "                \"auc_mean_by_group\": float(auc_values.mean()) if len(auc_values) else np.nan,\n",
    "                \"auc_std\": float(auc_values.std(ddof=1)) if len(auc_values) >= 2 else np.nan,\n",
    "                \"ece_mean_by_group\": float(ece_values.mean()) if len(ece_values) else np.nan,\n",
    "                \"ece_std\": float(ece_values.std(ddof=1)) if len(ece_values) >= 2 else np.nan,\n",
    "            }\n",
    "        )\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "age_group_metrics_df = metric_by_group(predictions_df, group_col=\"age_group\", n_bins=ECE_N_BINS)\n",
    "age_group_variability_df = group_metric_variability(age_group_metrics_df, group_col=\"age_group\")\n",
    "\n",
    "display(age_group_metrics_df)\n",
    "display(age_group_variability_df)\n",
    "\n",
    "if not age_group_metrics_df.empty:\n",
    "    age_group_metrics_df.to_csv(OUTPUT_AGE_GROUP_METRICS_CSV, index=False)\n",
    "    print(f\"Saved age group metrics: {OUTPUT_AGE_GROUP_METRICS_CSV.resolve()}\")\n",
    "if not age_group_variability_df.empty:\n",
    "    age_group_variability_df.to_csv(OUTPUT_AGE_GROUP_VARIABILITY_CSV, index=False)\n",
    "    print(f\"Saved age group variability: {OUTPUT_AGE_GROUP_VARIABILITY_CSV.resolve()}\")"
   ]
  }
