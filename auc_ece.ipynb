   "source": [
    "NONE_STRINGS = {\"\", \"none\", \"nan\", \"na\", \"n/a\", \"null\"}\n",
    "\n",
    "\n",
    "def normalize_task_label(series: pd.Series) -> pd.Series:\n",
    "    text = series.astype(\"string\").str.strip().str.lower()\n",
    "    text = text.mask(text.isin(NONE_STRINGS), other=pd.NA)\n",
    "    numeric = pd.to_numeric(text, errors=\"coerce\")\n",
    "    bad = sorted(set(numeric.dropna().unique()) - {0, 1})\n",
    "    if bad:\n",
    "        raise ValueError(f\"Found non-binary task labels after cleaning: {bad[:10]}\")\n",
    "    return numeric.astype(\"Float64\")\n",
    "\n",
    "\n",
    "missing_train_tasks = [c for c in TASK_COLS if c not in train_df.columns]\n",
    "missing_test_tasks = [c for c in TASK_COLS if c not in test_df.columns]\n",
    "if missing_train_tasks or missing_test_tasks:\n",
    "    raise ValueError(f\"Missing task columns. train missing={missing_train_tasks}; test missing={missing_test_tasks}\")\n",
    "\n",
    "for task in TASK_COLS:\n",
    "    train_df[task] = normalize_task_label(train_df[task])\n",
    "    test_df[task] = normalize_task_label(test_df[task])\n",
    "\n",
    "if FEATURE_COLS is None:\n",
    "    excluded = set(ID_COLS) | set(TASK_COLS) | {\"source_file\", \"source_split\"}\n",
    "    train_numeric = set(train_df.select_dtypes(include=[np.number, \"Float64\"]).columns)\n",
    "    test_numeric = set(test_df.select_dtypes(include=[np.number, \"Float64\"]).columns)\n",
    "    feature_cols = sorted((train_numeric & test_numeric) - excluded)\n",
    "else:\n",
    "    feature_cols = list(FEATURE_COLS)\n",
    "\n",
    "missing_train_features = [c for c in feature_cols if c not in train_df.columns]\n",
    "missing_test_features = [c for c in feature_cols if c not in test_df.columns]\n",
    "if missing_train_features or missing_test_features:\n",
    "    raise ValueError(f\"Missing feature columns. train missing={missing_train_features}; test missing={missing_test_features}\")\n",
    "\n",
    "for col in feature_cols:\n",
    "    train_df[col] = pd.to_numeric(train_df[col], errors=\"coerce\")\n",
    "    test_df[col] = pd.to_numeric(test_df[col], errors=\"coerce\")\n",
    "\n",
    "no_ctc_feature_cols = [col for col in feature_cols if col not in CTC_SIGNAL_COLS]\n",
    "missing_ctc_exclusions = [col for col in CTC_SIGNAL_COLS if col not in feature_cols]\n",
    "\n",
    "print(\"Tasks:\", TASK_COLS)\n",
    "print(\"Features:\", feature_cols)\n",
    "print(\"CTC signal columns excluded in no-CTC LR:\", CTC_SIGNAL_COLS)\n",
    "print(\"No-CTC features:\", no_ctc_feature_cols)\n",
    "if missing_ctc_exclusions:\n",
    "    print(\"CTC exclusion columns not present in active features:\", missing_ctc_exclusions)\n",
    "\n",
    "label_summary = []\n",
    "for split_name, frame in [(\"train\", train_df), (\"test\", test_df)]:\n",
    "    for task in TASK_COLS:\n",
    "        valid = frame[task].notna()\n",
    "        label_summary.append(\n",
    "            {\n",
    "                \"split\": split_name,\n",
    "                \"task\": task,\n",
    "                \"n_total\": len(frame),\n",
    "                \"n_valid\": int(valid.sum()),\n",
    "                \"n_none\": int((~valid).sum()),\n",
    "                \"n_pos\": int((frame.loc[valid, task] == 1).sum()),\n",
    "                \"n_neg\": int((frame.loc[valid, task] == 0).sum()),\n",
    "            }\n",
    "        )\n",
    "display(pd.DataFrame(label_summary))"
   ]
