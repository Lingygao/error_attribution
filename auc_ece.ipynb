    "metrics_rows = []\n",
    "prediction_frames = []\n",
    "models = {}\n",
    "\n",
    "for config in MODEL_CONFIGS:\n",
    "    model_version = config[\"model_version\"]\n",
    "    for task in TASK_COLS:\n",
    "        train_task = train_df[train_df[task].notna()].copy()\n",
    "        test_task = test_df[test_df[task].notna()].copy()\n",
    "\n",
    "        y_train = train_task[task].astype(int).to_numpy()\n",
    "        y_test = test_task[task].astype(int).to_numpy()\n",
    "\n",
    "        row = {\n",
    "            \"model_version\": model_version,\n",
    "            \"model_description\": config.get(\"description\"),\n",
    "            \"C\": config[\"C\"],\n",
    "            \"class_weight\": config.get(\"class_weight\"),\n",
    "            \"task\": task,\n",
    "            \"n_train\": len(train_task),\n",
    "            \"n_train_pos\": int((y_train == 1).sum()),\n",
    "            \"n_train_neg\": int((y_train == 0).sum()),\n",
    "            \"n_test\": len(test_task),\n",
    "            \"n_test_pos\": int((y_test == 1).sum()),\n",
    "            \"n_test_neg\": int((y_test == 0).sum()),\n",
    "            \"auc\": np.nan,\n",
    "            \"ece\": np.nan,\n",
    "            \"status\": \"ok\",\n",
    "        }\n",
    "\n",
    "        if len(feature_cols) == 0:\n",
    "            row[\"status\"] = \"no_features\"\n",
    "            metrics_rows.append(row)\n",
    "            continue\n",
    "        if len(np.unique(y_train)) < 2:\n",
    "            row[\"status\"] = \"train_only_one_class\"\n",
    "            metrics_rows.append(row)\n",
    "            continue\n",
    "        if len(test_task) == 0:\n",
    "            row[\"status\"] = \"no_test_rows_after_none_filter\"\n",
    "            metrics_rows.append(row)\n",
    "            continue\n",
    "\n",
    "        X_train = train_task[feature_cols].to_numpy(dtype=float)\n",
    "        X_test = test_task[feature_cols].to_numpy(dtype=float)\n",
    "\n",
    "        model = make_model(config)\n",
    "        model.fit(X_train, y_train)\n",
    "        prob = model.predict_proba(X_test)[:, 1]\n",
    "\n",
    "        row[\"auc\"] = binary_auc(y_test, prob)\n",
    "        row[\"ece\"] = expected_calibration_error(y_test, prob, n_bins=ECE_N_BINS)\n",
    "        if len(np.unique(y_test)) < 2:\n",
    "            row[\"status\"] = \"ok_but_test_auc_undefined_one_class\"\n",
    "\n",
    "        metrics_rows.append(row)\n",
    "        models[(model_version, task)] = model\n",
    "\n",
    "        keep_cols = [c for c in [\"speaker\", \"segment_id\", \"word_idx\", \"asr_word\", \"normalized_asr_word\", \"age\", \"age_group\", \"source_file\"] if c in test_task.columns]\n",
    "        pred_out = test_task[keep_cols].copy()\n",
    "        pred_out[\"model_version\"] = model_version\n",
    "        pred_out[\"C\"] = config[\"C\"]\n",
    "        pred_out[\"class_weight\"] = config.get(\"class_weight\")\n",
    "        pred_out[\"task\"] = task\n",
    "        pred_out[\"y_true\"] = y_test\n",
    "        pred_out[\"y_prob\"] = prob\n",
    "        prediction_frames.append(pred_out)\n",
    "\n",
    "metrics_df = pd.DataFrame(metrics_rows)\n",
    "predictions_df = pd.concat(prediction_frames, ignore_index=True, sort=False) if prediction_frames else pd.DataFrame()\n",
    "\n",
    "display(metrics_df)\n",
    "display(predictions_df.head())\n",
    "\n",
    "metrics_df.to_csv(OUTPUT_METRICS_CSV, index=False)\n",
    "predictions_df.to_csv(OUTPUT_PREDICTIONS_CSV, index=False)\n",
    "print(f\"Saved metrics: {OUTPUT_METRICS_CSV.resolve()}\")\n",
    "print(f\"Saved predictions: {OUTPUT_PREDICTIONS_CSV.resolve()}\")"
