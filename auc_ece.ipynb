   "source": [
    "def get_model_coefficients(model, feature_names):\n",
    "    if HAS_SKLEARN:\n",
    "        lr = model.named_steps[\"logisticregression\"]\n",
    "        coef = lr.coef_[0]\n",
    "        intercept = float(lr.intercept_[0])\n",
    "    else:\n",
    "        coef = model.coef_\n",
    "        intercept = float(model.intercept_)\n",
    "    rows = [{\"feature\": feature, \"coefficient\": float(value)} for feature, value in zip(feature_names, coef)]\n",
    "    rows.append({\"feature\": \"__intercept__\", \"coefficient\": intercept})\n",
    "    return rows\n",
    "\n",
    "\n",
    "single_signal_rows = []\n",
    "for task in TASK_COLS:\n",
    "    test_task = test_df[test_df[task].notna()].copy()\n",
    "    y_test = test_task[task].astype(int).to_numpy()\n",
    "    for feature in feature_cols:\n",
    "        score = pd.to_numeric(test_task[feature], errors=\"coerce\").to_numpy(dtype=float)\n",
    "        auc = binary_auc(y_test, score)\n",
    "        single_signal_rows.append(\n",
    "            {\n",
    "                \"task\": task,\n",
    "                \"feature\": feature,\n",
    "                \"test_single_signal_auc\": auc,\n",
    "                \"test_single_signal_auc_best_direction\": np.nan if pd.isna(auc) else max(auc, 1 - auc),\n",
    "                \"direction\": None if pd.isna(auc) else (\"higher_score_more_positive\" if auc >= 0.5 else \"lower_score_more_positive\"),\n",
    "                \"n_test\": int(test_task[[task, feature]].dropna().shape[0]),\n",
    "                \"n_test_pos\": int((y_test == 1).sum()),\n",
    "                \"n_test_neg\": int((y_test == 0).sum()),\n",
    "            }\n",
    "        )\n",
    "\n",
    "test_single_signal_auc_df = pd.DataFrame(single_signal_rows).sort_values(\n",
    "    [\"task\", \"test_single_signal_auc_best_direction\"], ascending=[True, False]\n",
    ")\n",
    "display(test_single_signal_auc_df)\n",
    "test_single_signal_auc_df.to_csv(OUTPUT_TEST_SINGLE_SIGNAL_AUC_CSV, index=False)\n",
    "print(f\"Saved test single-signal AUC: {OUTPUT_TEST_SINGLE_SIGNAL_AUC_CSV.resolve()}\")\n",
    "\n",
    "\n",
    "single_signal_age_rows = []\n",
    "if \"age_group\" not in test_df.columns:\n",
    "    print(\"age_group not found in test_df; skipping single-signal age-group AUC.\")\n",
    "else:\n",
    "    for task in TASK_COLS:\n",
    "        test_task = test_df[test_df[task].notna()].dropna(subset=[\"age_group\"]).copy()\n",
    "        for (age_group, group) in test_task.groupby(\"age_group\", sort=True, dropna=False):\n",
    "            y_group = group[task].astype(int).to_numpy()\n",
    "            n_pos = int((y_group == 1).sum())\n",
    "            n_neg = int((y_group == 0).sum())\n",
    "            for feature in feature_cols:\n",
    "                score = pd.to_numeric(group[feature], errors=\"coerce\").to_numpy(dtype=float)\n",
    "                auc = binary_auc(y_group, score)\n",
    "                single_signal_age_rows.append(\n",
    "                    {\n",
    "                        \"task\": task,\n",
    "                        \"feature\": feature,\n",
    "                        \"age_group\": age_group,\n",
    "                        \"n_test\": int(group[[task, feature]].dropna().shape[0]),\n",
    "                        \"n_test_pos\": n_pos,\n",
    "                        \"n_test_neg\": n_neg,\n",
    "                        \"auc\": auc,\n",
    "                        \"auc_best_direction\": np.nan if pd.isna(auc) else max(auc, 1 - auc),\n",
    "                        \"direction\": None if pd.isna(auc) else (\"higher_score_more_positive\" if auc >= 0.5 else \"lower_score_more_positive\"),\n",
    "                        \"status\": \"ok\" if n_pos > 0 and n_neg > 0 else \"only_one_class\",\n",
    "                    }\n",
    "                )\n",
    "\n",
    "test_single_signal_age_group_auc_df = pd.DataFrame(single_signal_age_rows)\n",
    "if not test_single_signal_age_group_auc_df.empty:\n",
    "    test_single_signal_age_group_auc_df = test_single_signal_age_group_auc_df.sort_values(\n",
    "        [\"task\", \"feature\", \"age_group\"]\n",
    "    ).reset_index(drop=True)\n",
    "\n",
    "single_signal_age_variability_df = pd.DataFrame()\n",
    "if not test_single_signal_age_group_auc_df.empty:\n",
    "    single_signal_age_variability_df = (\n",
    "        test_single_signal_age_group_auc_df.groupby([\"task\", \"feature\"], as_index=False)\n",
    "        .agg(\n",
    "            n_age_groups=(\"age_group\", \"nunique\"),\n",
    "            n_age_groups_auc_defined=(\"auc\", lambda s: int(s.notna().sum())),\n",
    "            mean_auc_best_direction=(\"auc_best_direction\", \"mean\"),\n",
    "            min_auc_best_direction=(\"auc_best_direction\", \"min\"),\n",
    "            auc_best_direction_std=(\"auc_best_direction\", lambda s: float(s.dropna().std(ddof=1)) if s.dropna().shape[0] >= 2 else np.nan),\n",
    "        )\n",
    "        .sort_values([\"task\", \"mean_auc_best_direction\"], ascending=[True, False])\n",
    "        .reset_index(drop=True)\n",
