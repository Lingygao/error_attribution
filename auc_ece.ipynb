    "## 10. ECE bin ",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def calibration_bins(y_true, prob, n_bins=10):\n",
    "    y = np.asarray(y_true, dtype=float)\n",
    "    p = np.asarray(prob, dtype=float)\n",
    "    mask = np.isfinite(y) & np.isfinite(p)\n",
    "    y = y[mask]\n",
    "    p = np.clip(p[mask], 0, 1)\n",
    "    edges = np.linspace(0, 1, n_bins + 1)\n",
    "    rows = []\n",
    "    for i in range(n_bins):\n",
    "        left, right = edges[i], edges[i + 1]\n",
    "        in_bin = ((p >= left) & (p <= right)) if i == n_bins - 1 else ((p >= left) & (p < right))\n",
    "        rows.append(\n",
    "            {\n",
    "                \"bin\": i,\n",
    "                \"bin_left\": left,\n",
    "                \"bin_right\": right,\n",
    "                \"n\": int(in_bin.sum()),\n",
    "                \"accuracy\": np.nan if not np.any(in_bin) else float(y[in_bin].mean()),\n",
    "                \"confidence\": np.nan if not np.any(in_bin) else float(p[in_bin].mean()),\n",
    "                \"abs_gap\": np.nan if not np.any(in_bin) else float(abs(y[in_bin].mean() - p[in_bin].mean())),\n",
    "            }\n",
    "        )\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "bin_frames = []\n",
    "if not predictions_df.empty:\n",
    "    for (model_version, task), group in predictions_df.groupby([\"model_version\", \"task\"], sort=False):\n",
    "        bins = calibration_bins(group[\"y_true\"], group[\"y_prob\"], n_bins=ECE_N_BINS)\n",
    "        bins.insert(0, \"model_version\", model_version)\n",
    "        bins.insert(0, \"task\", task)\n",
    "        bin_frames.append(bins)\n",
    "\n",
    "calibration_df = pd.concat(bin_frames, ignore_index=True) if bin_frames else pd.DataFrame()\n",
    "display(calibration_df)\n",
    "if not calibration_df.empty:\n",
    "    calibration_df.to_csv(\"logreg_task_calibration_bins.csv\", index=False)\n",
    "    print(\"Saved calibration bins: logreg_task_calibration_bins.csv\")"
   ]
