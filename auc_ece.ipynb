   "source": [
    "# Train/Test Logistic Regression for 3 Word-Level Tasks\n", 
    " We have three tasks: sanity check task (correct and mistake) and insertion, substitution distinguishing task",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# NOTE: This notebook contains a dedicated section named:\n",
    "# ## 12. NO CTC MODULE\n",
    "# Search for \"NO CTC MODULE\" if the notebook UI does not show the later section immediately.\n",
    "\n",
    "from pathlib import Path\n",
    "import json\n",
    "import re\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "try:\n",
    "    from sklearn.impute import SimpleImputer\n",
    "    from sklearn.linear_model import LogisticRegression\n",
    "    from sklearn.pipeline import make_pipeline\n",
    "    from sklearn.preprocessing import StandardScaler\n",
    "    HAS_SKLEARN = True\n",
    "except ImportError:\n",
    "    HAS_SKLEARN = False\n",
    "\n",
    "pd.set_option(\"display.max_columns\", 120)\n",
    "pd.set_option(\"display.width\", 180)\n",
    "print(\"HAS_SKLEARN =\", HAS_SKLEARN)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. configure\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# One root folder contains all speaker subfolders. Train/test are defined by speaker-list files.\n",
    "ALL_SPEAKER_ROOT = Path(\"/vol/tensusers/lgao/uncertainty_whisper/0_uncertainty_attribution_whisper/data/jasmin/output_final/v2_segment\")\n",
    "TRAIN_SPEAKER_LIST = Path(\"train.txt\")\n",
    "TEST_SPEAKER_LIST = Path(\"test.txt\")\n",
    "\n",
    "# Each selected speaker folder should contain one *_with_signals.csv file.\n",
    "SPEAKER_FILE_GLOB_TEMPLATE = \"{speaker}/{speaker}_pr_mt_v2_task_label_table_with_signals.csv\"\n",
    "FALLBACK_SPEAKER_FILE_GLOB = \"{speaker}/*_pr_mt_v2_task_label_table_with_signals.csv\"\n",
    "EXCLUDE_NAME_CONTAINS = [\"signal_link_skipped\"]\n",
    "FILE_EXTENSIONS = {\".csv\", \".tsv\", \".xlsx\", \".xls\"}\n",
    "\n",
    "# Three binary task label columns. Empty/None/NaN labels are dropped task-by-task.\n",
    "TASK_COLS = [\"task1\", \"task2\", \"task3\"]\n",
    "\n",
    "# 不作为特征的列。\n",
    "ID_COLS = [\n",
    "    \"speaker\",\n",
    "    \"speaker_id\",\n",
    "    \"speaker_from_path\",\n",
    "    \"segment_id\",\n",
    "    \"asr_index\",\n",
    "    \"word_idx\",\n",
    "    \"asr_word\",\n",
    "    \"normalized_asr_word\",\n",
    "    \"token_pieces\",\n",
    "    \"aligned_alternative_words\",\n",
    "    \"mt_words\",\n",
    "    \"pr_mt_prompt_words\",\n",
    "    \"pr_v_prompt_words\",\n",
    "    \"mt_v_label\",\n",
    "    \"pr_mt_labels\",\n",
    "    \"pr_v_label\",\n",
    "    \"source_mt_v_json\",\n",
    "    \"source_pr_mt_json\",\n",
    "    \"source_pr_v_json\",\n",
    "]\n",
    "\n",
    "# Numeric signal columns used by logistic regression. aligned_alternative_words is text/list, so it is not used directly.\n",
    "FEATURE_COLS = [\n",
    "    \"attn_entropy_mean\",\n",
    "    \"A_ctc\",\n",
    "    \"A_std\",\n",
    "    \"audio_entropy\",\n",
    "    \"decoding_consistency\",\n",
    "    \"lm_confidence\",\n",
    "    \"lm_entropy\",\n",
    "    \"lm_margin\",\n",
    "]\n",
    "CTC_SIGNAL_COLS = [\"A_ctc\", \"A_std\", \"audio_entropy\"]\n",
    "\n",
    "# ECE ：equal-width probability bins。\n",
    "ECE_N_BINS = 10\n",
    "\n",
    "# Logistic regression configs: conservative primary result and relaxed sensitivity check.\n",
    "RANDOM_SEED = 42\n",
    "MAX_ITER = 2000\n",
    "LEARNING_RATE = 0.05\n",
    "MODEL_CONFIGS = [\n",
    "    {\n",
    "        \"model_version\": \"conservative_C0.1_unweighted\",\n",
    "        \"description\": \"Primary: stronger L2 regularization without class weights.\",\n",
    "        \"C\": 0.1,\n",
    "        \"class_weight\": None,\n",
    "    },\n",
    "    {\n",
    "        \"model_version\": \"relaxed_C1.0_unweighted\",\n",
    "        \"description\": \"Sensitivity: weaker L2 regularization without class weights.\",\n",
    "        \"C\": 1.0,\n",
    "        \"class_weight\": None,\n",
    "    },\n",
    "]\n",
    "\n",
    "OUTPUT_METRICS_CSV = Path(\"logreg_task_test_metrics.csv\")\n",
    "OUTPUT_PREDICTIONS_CSV = Path(\"logreg_task_test_predictions.csv\")\n",
    "OUTPUT_NO_CTC_METRICS_CSV = Path(\"logreg_no_ctc_task_test_metrics.csv\")\n",
    "OUTPUT_NO_CTC_PREDICTIONS_CSV = Path(\"logreg_no_ctc_task_test_predictions.csv\")\n",
    "OUTPUT_TEST_SINGLE_SIGNAL_AUC_CSV = Path(\"logreg_test_single_signal_auc.csv\")\n",
    "OUTPUT_TEST_SINGLE_SIGNAL_AGE_GROUP_CSV = Path(\"logreg_test_single_signal_age_group_auc.csv\")\n",
    "OUTPUT_TEST_SINGLE_SIGNAL_AGE_VARIABILITY_CSV = Path(\"logreg_test_single_signal_age_group_variability.csv\")\n",
    "OUTPUT_SINGLE_FEATURE_LOGREG_CSV = Path(\"logreg_single_feature_test_metrics.csv\")\n",
    "OUTPUT_LOGREG_COEFFICIENTS_CSV = Path(\"logreg_feature_coefficients.csv\")\n",
    "OUTPUT_TASK3_PHONEMIC_FILTER_CSV = Path(\"task3_phonemic_filter_excluded_rows.csv\")\n",
    "OUTPUT_AGE_GROUP_METRICS_CSV = Path(\"logreg_task_age_group_metrics.csv\")\n",
    "OUTPUT_AGE_GROUP_VARIABILITY_CSV = Path(\"logreg_task_age_group_variability.csv\")\n",
    "\n",
    "# Optional age metadata for test speakers. In this project, Root looks like fn000049 and can map to speaker.\n",
    "AGE_TABLE_PATH = Path(\"sprekers_informatie.xlsx - Sheet1.csv\")\n",
    "AGE_TABLE_SPEAKER_COL = \"Root\"\n",
    "TEST_SPEAKER_COL = \"speaker\"\n",
    "AGE_COL = \"Age\"\n",
    "\n",
    "# If AGE_GROUP_COL is None, age_group is created from numeric Age.\n",
    "# AGE_GROUP_MODE = \"exact\" uses each age as its own group; \"bins\" uses AGE_BINS.\n",
    "AGE_GROUP_COL = None\n",
    "AGE_GROUP_MODE = \"bins\"\n",
    "AGE_BINS = [0, 7, 8, 9, 10, 11, 12, 13]\n",
    "AGE_BIN_LABELS = [\"<=7\", \"8\", \"9\", \"10\", \"11\", \"12\", \"13\"]\n",
    "\n",
    "# Task3 label-ambiguity filter for substitution cases with PR != MT.\n",
    "APPLY_TASK3_PHONEMIC_FILTER = True\n",
    "TASK3_FILTER_TAU = 0.2\n",
    "AO_COL = \"asr_word\"\n",
    "PR_COL = \"pr_mt_prompt_words\"\n",
    "MT_COL = \"mt_words\"\n",
    "TASK3_COL = \"task3\"\n",
    "LEXICON_PATH = Path(\"power_runs/merged_lexicon.json\")\n",
    "TASK3_FILTER_OUTPUT_COLUMNS = [\n",
    "    \"source_split\",\n",
    "    \"speaker\",\n",
    "    AO_COL,\n",
    "    PR_COL,\n",
    "    MT_COL,\n",
    "    \"pr_v_label\",\n",
    "    TASK3_COL,\n",
    "    \"task3_phonemic_similarity\",\n",
    "    \"source_file\",\n",
    "]"
   ]
  },
  {
   "cell_type": "markdown",
