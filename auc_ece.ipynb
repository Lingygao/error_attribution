   "source": [
    "## 6. 模型和指标函数\n",
    "\n",
    "AUC 用 rank-based 实现；ECE 使用 equal-width bins，计算 `sum(bin_size / n * abs(acc - confidence))`。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def sigmoid(z):\n",
    "    z = np.clip(z, -35, 35)\n",
    "    return 1 / (1 + np.exp(-z))\n",
    "\n",
    "\n",
    "def binary_auc(y_true, score):\n",
    "    y = np.asarray(y_true, dtype=float)\n",
    "    s = np.asarray(score, dtype=float)\n",
    "    mask = np.isfinite(y) & np.isfinite(s)\n",
    "    y = y[mask]\n",
    "    s = s[mask]\n",
    "    n_pos = int(np.sum(y == 1))\n",
    "    n_neg = int(np.sum(y == 0))\n",
    "    if n_pos == 0 or n_neg == 0:\n",
    "        return np.nan\n",
    "    ranks = pd.Series(s).rank(method=\"average\").to_numpy()\n",
    "    rank_sum_pos = ranks[y == 1].sum()\n",
    "    return float((rank_sum_pos - n_pos * (n_pos + 1) / 2) / (n_pos * n_neg))\n",
    "\n",
    "\n",
    "def expected_calibration_error(y_true, prob, n_bins=10):\n",
    "    y = np.asarray(y_true, dtype=float)\n",
    "    p = np.asarray(prob, dtype=float)\n",
    "    mask = np.isfinite(y) & np.isfinite(p)\n",
    "    y = y[mask]\n",
    "    p = np.clip(p[mask], 0, 1)\n",
    "    if len(y) == 0:\n",
    "        return np.nan\n",
    "\n",
    "    edges = np.linspace(0, 1, n_bins + 1)\n",
    "    ece = 0.0\n",
    "    for i in range(n_bins):\n",
    "        left = edges[i]\n",
    "        right = edges[i + 1]\n",
    "        if i == n_bins - 1:\n",
    "            in_bin = (p >= left) & (p <= right)\n",
    "        else:\n",
    "            in_bin = (p >= left) & (p < right)\n",
    "        if not np.any(in_bin):\n",
    "            continue\n",
    "        acc = y[in_bin].mean()\n",
    "        conf = p[in_bin].mean()\n",
    "        ece += (in_bin.mean()) * abs(acc - conf)\n",
    "    return float(ece)\n",
    "\n",
    "\n",
    "class NumpyLogisticRegression:\n",
    "    def __init__(self, l2=1.0, class_weight=None, learning_rate=0.05, max_iter=2000, seed=42):\n",
    "        self.l2 = l2\n",
    "        self.class_weight = class_weight\n",
    "        self.learning_rate = learning_rate\n",
    "        self.max_iter = max_iter\n",
    "        self.seed = seed\n",
    "\n",
    "    def fit(self, X, y):\n",
    "        X = np.asarray(X, dtype=float)\n",
    "        y = np.asarray(y, dtype=float)\n",
    "        self.feature_mean_ = np.nanmean(X, axis=0)\n",
    "        self.feature_mean_ = np.where(np.isfinite(self.feature_mean_), self.feature_mean_, 0.0)\n",
    "        X = np.where(np.isfinite(X), X, self.feature_mean_)\n",
    "        self.feature_std_ = X.std(axis=0)\n",
    "        self.feature_std_ = np.where(self.feature_std_ > 0, self.feature_std_, 1.0)\n",
    "        Xs = (X - self.feature_mean_) / self.feature_std_\n",
    "\n",
    "        rng = np.random.default_rng(self.seed)\n",
    "        self.coef_ = rng.normal(0, 0.01, size=Xs.shape[1])\n",
    "        self.intercept_ = 0.0\n",
    "\n",
    "        n = len(y)\n",
    "        sample_weight = np.ones(n, dtype=float)\n",
    "        if self.class_weight == \"balanced\":\n",
    "            classes, counts = np.unique(y, return_counts=True)\n",
    "            weights = {cls: n / (len(classes) * count) for cls, count in zip(classes, counts)}\n",
    "            sample_weight = np.array([weights[value] for value in y], dtype=float)\n",
    "        weight_sum = sample_weight.sum()\n",
    "        for _ in range(self.max_iter):\n",
    "            pred = sigmoid(Xs @ self.coef_ + self.intercept_)\n",
    "            error = (pred - y) * sample_weight\n",
    "            grad_w = (Xs.T @ error) / weight_sum + self.l2 * self.coef_ / n\n",
    "            grad_b = error.sum() / weight_sum\n",
    "            self.coef_ -= self.learning_rate * grad_w\n",
    "            self.intercept_ -= self.learning_rate * grad_b\n",
    "        return self\n",
    "\n",
    "    def predict_proba(self, X):\n",
    "        X = np.asarray(X, dtype=float)\n",
    "        X = np.where(np.isfinite(X), X, self.feature_mean_)\n",
    "        Xs = (X - self.feature_mean_) / self.feature_std_\n",
    "        p = sigmoid(Xs @ self.coef_ + self.intercept_)\n",
    "        return np.column_stack([1 - p, p])\n",
    "\n",
    "\n",
    "def make_model(config):\n",
    "    C = float(config[\"C\"])\n",
    "    class_weight = config.get(\"class_weight\")\n",
    "    if HAS_SKLEARN:\n",
    "        return make_pipeline(\n",
    "            SimpleImputer(strategy=\"mean\"),\n",
    "            StandardScaler(),\n",
    "            LogisticRegression(\n",
    "                penalty=\"l2\",\n",
    "                C=C,\n",
    "                class_weight=class_weight,\n",
    "                max_iter=MAX_ITER,\n",
    "                random_state=RANDOM_SEED,\n",
    "                solver=\"lbfgs\",\n",
    "            ),\n",
    "        )\n",
    "    return NumpyLogisticRegression(\n",
    "        l2=1 / C,\n",
    "        class_weight=class_weight,\n",
    "        learning_rate=LEARNING_RATE,\n",
    "        max_iter=MAX_ITER,\n",
    "        seed=RANDOM_SEED,\n",
    "    )"
   ]
  },
