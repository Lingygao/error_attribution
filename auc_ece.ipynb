   "source": [
    "## 2. read train and test \n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def read_speaker_list(path: Path) -> list[str]:\n",
    "    if not path.exists():\n",
    "        raise FileNotFoundError(f\"Speaker list not found: {path.resolve()}\")\n",
    "    speakers = []\n",
    "    for line in path.read_text(encoding=\"utf-8\").splitlines():\n",
    "        value = line.strip()\n",
    "        if value and not value.startswith(\"#\"):\n",
    "            speakers.append(value)\n",
    "    return speakers\n",
    "\n",
    "\n",
    "def find_speaker_file(root: Path, speaker: str) -> Path | None:\n",
    "    exact = root / SPEAKER_FILE_GLOB_TEMPLATE.format(speaker=speaker)\n",
    "    candidates = [exact] if exact.exists() else []\n",
    "    if not candidates:\n",
    "        candidates = sorted(root.glob(FALLBACK_SPEAKER_FILE_GLOB.format(speaker=speaker)))\n",
    "    candidates = [p for p in candidates if p.is_file() and p.suffix.lower() in FILE_EXTENSIONS]\n",
    "    candidates = [p for p in candidates if not any(token in p.name for token in EXCLUDE_NAME_CONTAINS)]\n",
    "    return candidates[0] if candidates else None\n",
    "\n",
    "\n",
    "def read_table(path: Path) -> pd.DataFrame:\n",
    "    suffix = path.suffix.lower()\n",
    "    if suffix in {\".xlsx\", \".xls\"}:\n",
    "        return pd.read_excel(path)\n",
    "    if suffix == \".tsv\":\n",
    "        return pd.read_csv(path, sep=\"\\t\")\n",
    "    return pd.read_csv(path)\n",
    "\n",
    "\n",
    "def load_split_from_speaker_list(root: Path, speaker_list_path: Path, split_name: str) -> pd.DataFrame:\n",
    "    speakers = read_speaker_list(speaker_list_path)\n",
    "    rows = []\n",
    "    files = []\n",
    "    missing = []\n",
    "    for speaker in speakers:\n",
    "        path = find_speaker_file(root, speaker)\n",
    "        if path is None:\n",
    "            missing.append(speaker)\n",
    "        else:\n",
    "            files.append((speaker, path))\n",
    "    if not files:\n",
    "        raise FileNotFoundError(f\"No signal files found for {split_name} speakers under {root.resolve()}\")\n",
    "\n",
    "    frames = []\n",
    "    for speaker, path in files:\n",
    "        one = read_table(path)\n",
    "        one.columns = [str(c).strip() for c in one.columns]\n",
    "        one[\"speaker_from_path\"] = speaker\n",
    "        if \"speaker\" not in one.columns:\n",
    "            one.insert(0, \"speaker\", speaker)\n",
    "        one[\"source_file\"] = str(path)\n",
    "        one[\"source_split\"] = split_name\n",
    "        frames.append(one)\n",
    "    print(f\"Loaded {len(files)} {split_name} speaker files from {root.resolve()}\")\n",
    "    if missing:\n",
    "        print(f\"Missing {len(missing)} {split_name} speakers with no matching file. First 20: {missing[:20]}\")\n",
    "    display(pd.DataFrame({\"speaker\": [s for s, _ in files], \"source_file\": [str(p) for _, p in files]}).head(20))\n",
    "    return pd.concat(frames, ignore_index=True, sort=False)\n",
    "\n",
    "\n",
    "if ALL_SPEAKER_ROOT.exists() and TRAIN_SPEAKER_LIST.exists() and TEST_SPEAKER_LIST.exists():\n",
    "    train_df = load_split_from_speaker_list(ALL_SPEAKER_ROOT, TRAIN_SPEAKER_LIST, \"train\")\n",
    "    test_df = load_split_from_speaker_list(ALL_SPEAKER_ROOT, TEST_SPEAKER_LIST, \"test\")\n",
    "else:\n",
    "    print(\"ALL_SPEAKER_ROOT or train/test speaker list not found; using a tiny demo dataset so the notebook can run end-to-end.\")\n",
    "    rng = np.random.default_rng(RANDOM_SEED)\n",
    "\n",
    "    def make_demo(n, split):\n",
    "        x1 = rng.normal(size=n)\n",
    "        x2 = rng.normal(size=n)\n",
    "        x3 = rng.normal(size=n)\n",
    "        p1 = 1 / (1 + np.exp(-(1.2 * x1 - 0.4 * x2)))\n",
    "        p2 = 1 / (1 + np.exp(-(-0.8 * x1 + 0.9 * x3)))\n",
    "        p3 = 1 / (1 + np.exp(-(0.5 * x2 + 0.7 * x3)))\n",
    "        out = pd.DataFrame(\n",
    "            {\n",
    "                \"speaker\": [f\"demo_{split}_{i // 30:02d}\" for i in range(n)],\n",
    "                \"segment_id\": np.arange(n) // 10,\n",
    "                \"word_idx\": np.arange(n) % 10,\n",
    "                \"asr_word\": [f\"word_{i}\" for i in range(n)],\n",
    "                \"attn_entropy_mean\": rng.normal(size=n),\n",
    "                \"A_ctc\": x1,\n",
    "                \"A_std\": x2,\n",
    "                \"audio_entropy\": x3,\n",
    "                \"decoding_consistency\": rng.uniform(0, 1, size=n),\n",
    "                \"aligned_alternative_words\": [\"[]\"] * n,\n",
    "                \"lm_confidence\": rng.uniform(0, 1, size=n),\n",
    "                \"lm_entropy\": rng.normal(size=n),\n",
    "                \"lm_margin\": rng.uniform(0, 1, size=n),\n",
    "                \"task1\": rng.binomial(1, p1).astype(object),\n",
    "                \"task2\": rng.binomial(1, p2).astype(object),\n",
    "                \"task3\": rng.binomial(1, p3).astype(object),\n",
    "                \"source_file\": f\"demo_{split}.csv\",\n",
    "                \"source_split\": split,\n",
    "                \"speaker_from_path\": [f\"demo_{split}_{i // 30:02d}\" for i in range(n)],\n",
    "            }\n",
    "        )\n",
    "        none_mask = rng.random(n) < 0.12\n",
    "        out.loc[none_mask, \"task2\"] = \"None\"\n",
    "        return out\n",
    "\n",
    "    train_df = make_demo(180, \"train\")\n",
    "    test_df = make_demo(90, \"test\")\n",
    "\n",
    "print(\"train:\", train_df.shape)\n",
    "print(\"test:\", test_df.shape)\n",
    "display(train_df.head())\n",
    "display(test_df.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Add test speaker age groups\n",
    "\n",
    "This step merges test speaker age labels into `test_df`. If `AGE_GROUP_COL` is provided, that column is used directly. Otherwise, `age_group` is created from numeric `Age` using either exact ages or configured bins."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def add_age_groups_to_test(test_frame: pd.DataFrame) -> pd.DataFrame:\n",
    "    out = test_frame.copy()\n",
    "    if \"age_group\" in out.columns:\n",
    "        return out\n",
    "\n",
    "    if not AGE_TABLE_PATH.exists():\n",
    "        print(f\"Age table not found: {AGE_TABLE_PATH}. age_group analysis will be skipped.\")\n",
    "        out[\"age\"] = pd.NA\n",
    "        out[\"age_group\"] = pd.NA\n",
    "        return out\n",
    "\n",
    "    age_df = read_table(AGE_TABLE_PATH)\n",
    "    age_df.columns = [str(c).strip() for c in age_df.columns]\n",
    "    required = [AGE_TABLE_SPEAKER_COL, AGE_COL]\n",
    "    missing = [c for c in required if c not in age_df.columns]\n",
    "    if missing:\n",
    "        raise ValueError(f\"Age table missing columns {missing}. Available columns: {list(age_df.columns)}\")\n",
    "    if TEST_SPEAKER_COL not in out.columns:\n",
    "        raise ValueError(f\"test_df does not have TEST_SPEAKER_COL={TEST_SPEAKER_COL!r}\")\n",
    "\n",
    "    keep_cols = [AGE_TABLE_SPEAKER_COL, AGE_COL]\n",
    "    if AGE_GROUP_COL is not None:\n",
    "        if AGE_GROUP_COL not in age_df.columns:\n",
    "            raise ValueError(f\"AGE_GROUP_COL={AGE_GROUP_COL!r} not found in age table\")\n",
    "        keep_cols.append(AGE_GROUP_COL)\n",
    "\n",
    "    meta = age_df[keep_cols].drop_duplicates(subset=[AGE_TABLE_SPEAKER_COL]).copy()\n",
    "    meta = meta.rename(columns={AGE_TABLE_SPEAKER_COL: TEST_SPEAKER_COL, AGE_COL: \"age\"})\n",
    "    meta[TEST_SPEAKER_COL] = meta[TEST_SPEAKER_COL].astype(str).str.strip()\n",
    "    out[TEST_SPEAKER_COL] = out[TEST_SPEAKER_COL].astype(str).str.strip()\n",
    "\n",
    "    out = out.merge(meta, on=TEST_SPEAKER_COL, how=\"left\", validate=\"many_to_one\")\n",
    "    out[\"age\"] = pd.to_numeric(out[\"age\"], errors=\"coerce\")\n",
    "    if out[\"age\"].notna().sum() == 0 and out.get(\"source_file\", pd.Series(dtype=str)).astype(str).str.startswith(\"demo_\").all():\n",
    "        speaker_codes = pd.factorize(out[TEST_SPEAKER_COL])[0]\n",
    "        out[\"age\"] = 8 + (speaker_codes % 5)\n",
    "        print(\"No demo speakers matched the age table; assigned deterministic demo ages for notebook testing.\")\n",
    "\n",
    "    if AGE_GROUP_COL is not None:\n",
    "        out[\"age_group\"] = out[AGE_GROUP_COL].astype(\"string\").str.strip()\n",
    "    elif AGE_GROUP_MODE == \"bins\":\n",
    "        out[\"age_group\"] = pd.cut(out[\"age\"], bins=AGE_BINS, labels=AGE_BIN_LABELS, include_lowest=True, right=True).astype(\"string\")\n",
    "    elif AGE_GROUP_MODE == \"exact\":\n",
    "        out[\"age_group\"] = out[\"age\"].round().astype(\"Int64\").astype(\"string\")\n",
    "    else:\n",
    "        raise ValueError(f\"Unknown AGE_GROUP_MODE: {AGE_GROUP_MODE}\")\n",
    "\n",
    "    out.loc[out[\"age\"].isna(), \"age_group\"] = pd.NA\n",
    "    return out\n",
    "\n",
    "\n",
    "test_df = add_age_groups_to_test(test_df)\n",
    "\n",
    "if \"age_group\" in test_df.columns:\n",
    "    age_summary = (\n",
    "        test_df.dropna(subset=[\"age_group\"])\n",
    "        .groupby(\"age_group\", dropna=False)\n",
    "        .agg(n_words=(\"age_group\", \"size\"), n_speakers=(TEST_SPEAKER_COL, \"nunique\"), mean_age=(\"age\", \"mean\"))\n",
    "        .reset_index()\n",
    "    )\n",
    "    display(age_summary)\n",
    "    print(\"test rows without age_group:\", int(test_df[\"age_group\"].isna().sum()))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Task3 phonemic ambiguity filter\n",
    "\n",
    "For substitution cases where `PR != MT`, task3 labels are treated as ambiguous when phonemic similarity between `AO` and `PR` is below `tau=0.2`. Those rows keep their other task labels, but `task3` is set to missing so it is excluded from task3 training/evaluation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_lexicon(path: Path) -> dict[str, str]:\n",
    "    if not path.exists():\n",
    "        print(f\"Lexicon not found: {path}. Falling back to character-level similarity.\")\n",
    "        return {}\n",
    "    with path.open(\"r\", encoding=\"utf-8\") as fin:\n",
    "        return {str(k).lower(): str(v) for k, v in json.load(fin).items()}\n",
    "\n",
    "\n",
    "def normalize_word_text(value) -> str:\n",
    "    if pd.isna(value):\n",
    "        return \"\"\n",
    "    return str(value).strip().lower()\n",
    "\n",
    "\n",
    "def split_word_cell(value) -> list[str]:\n",
    "    text = normalize_word_text(value)\n",
    "    if not text:\n",
    "        return []\n",
    "    parts = re.split(r\"\\s*\\|\\s*|\\s+\", text)\n",
    "    return [part for part in parts if part]\n",
    "\n",
    "\n",
    "def words_to_phone_tokens(words: list[str], lexicon: dict[str, str]) -> list[str]:\n",
    "    tokens = []\n",
    "    for word in words:\n",
    "        phones = lexicon.get(word)\n",
    "        if phones:\n",
    "            tokens.extend(phone for phone in phones.split() if phone and phone != \"#\")\n",
    "        else:\n",
    "            # OOV fallback keeps close forms such as ate/eat from being discarded solely because they are missing from the lexicon.\n",
    "            tokens.extend(list(word))\n",
    "    return tokens\n",
    "\n",
    "\n",
    "def edit_distance(a: list[str], b: list[str]) -> int:\n",
    "    if not a:\n",
    "        return len(b)\n",
    "    if not b:\n",
    "        return len(a)\n",
    "    prev = list(range(len(b) + 1))\n",
    "    for i, x in enumerate(a, start=1):\n",
    "        curr = [i]\n",
    "        for j, y in enumerate(b, start=1):\n",
    "            curr.append(min(prev[j] + 1, curr[j - 1] + 1, prev[j - 1] + int(x != y)))\n",
    "        prev = curr\n",
    "    return prev[-1]\n",
    "\n",
    "\n",
    "def phonemic_similarity(ao_value, pr_value, lexicon: dict[str, str]) -> float:\n",
    "    ao_tokens = words_to_phone_tokens(split_word_cell(ao_value), lexicon)\n",
    "    pr_tokens = words_to_phone_tokens(split_word_cell(pr_value), lexicon)\n",
    "    max_len = max(len(ao_tokens), len(pr_tokens))\n",
    "    if max_len == 0:\n",
    "        return np.nan\n",
    "    distance = edit_distance(ao_tokens, pr_tokens)\n",
    "    return float(max(0.0, 1.0 - distance / max_len))\n",
    "\n",
    "\n",
    "def apply_task3_phonemic_filter(frame: pd.DataFrame, split_name: str, lexicon: dict[str, str]) -> tuple[pd.DataFrame, pd.DataFrame]:\n",
    "    out = frame.copy()\n",
    "    required = [AO_COL, PR_COL, MT_COL, TASK3_COL]\n",
    "    missing = [col for col in required if col not in out.columns]\n",
    "    if missing:\n",
    "        print(f\"Skipping task3 phonemic filter for {split_name}; missing columns: {missing}\")\n",
    "        out[\"task3_phonemic_similarity\"] = np.nan\n",
    "        out[\"task3_phonemic_filter_excluded\"] = False\n",
    "        return out, pd.DataFrame()\n",
    "\n",
    "    task3_present = out[TASK3_COL].astype(\"string\").str.strip().notna() & out[TASK3_COL].astype(\"string\").str.strip().ne(\"\")\n",
    "    pr_norm = out[PR_COL].map(normalize_word_text)\n",
    "    mt_norm = out[MT_COL].map(normalize_word_text)\n",
    "    pr_diff_mt = pr_norm.ne(mt_norm)\n",
    "    if \"pr_v_label\" in out.columns:\n",
    "        substitution_case = out[\"pr_v_label\"].astype(\"string\").str.strip().str.upper().eq(\"S\")\n",
    "    else:\n",
    "        substitution_case = task3_present\n",
    "\n",
    "    candidates = task3_present & substitution_case & pr_diff_mt\n",
    "    out[\"task3_phonemic_similarity\"] = np.nan\n",
    "    out.loc[candidates, \"task3_phonemic_similarity\"] = [\n",
    "        phonemic_similarity(ao, pr, lexicon)\n",
    "        for ao, pr in zip(out.loc[candidates, AO_COL], out.loc[candidates, PR_COL])\n",
    "    ]\n",
    "    excluded = candidates & out[\"task3_phonemic_similarity\"].lt(TASK3_FILTER_TAU)\n",
    "    out[\"task3_phonemic_filter_excluded\"] = excluded\n",
    "    out.loc[excluded, TASK3_COL] = pd.NA\n",
    "\n",
    "    excluded_rows = out.loc[excluded].copy()\n",
    "    excluded_rows[\"source_split\"] = split_name\n",
    "    print(\n",
    "        f\"{split_name}: task3 phonemic filter candidates={int(candidates.sum())}, \"\n",
    "        f\"excluded={int(excluded.sum())}, tau={TASK3_FILTER_TAU}\"\n",
    "    )\n",
    "    return out, excluded_rows\n",
    "\n",
    "\n",
    "if APPLY_TASK3_PHONEMIC_FILTER:\n",
    "    phonemic_lexicon = load_lexicon(LEXICON_PATH)\n",
    "    print(\"Sanity check similarity ate/eat:\", phonemic_similarity(\"ate\", \"eat\", phonemic_lexicon))\n",
    "    train_df, train_task3_excluded = apply_task3_phonemic_filter(train_df, \"train\", phonemic_lexicon)\n",
    "    test_df, test_task3_excluded = apply_task3_phonemic_filter(test_df, \"test\", phonemic_lexicon)\n",
    "    task3_excluded_df = pd.concat([train_task3_excluded, test_task3_excluded], ignore_index=True, sort=False)\n",
    "else:\n",
    "    task3_excluded_df = pd.DataFrame()\n",
    "\n",
    "for col in TASK3_FILTER_OUTPUT_COLUMNS:\n",
    "    if col not in task3_excluded_df.columns:\n",
    "        task3_excluded_df[col] = pd.Series(dtype=\"object\")\n",
    "task3_filter_output_df = task3_excluded_df[TASK3_FILTER_OUTPUT_COLUMNS].copy()\n",
    "\n",
    "print(\"Current working directory:\", Path.cwd())\n",
    "print(\"Task3 phonemic excluded rows:\", len(task3_filter_output_df))\n",
    "display(task3_filter_output_df.head(20))\n",
    "task3_filter_output_df.to_csv(OUTPUT_TASK3_PHONEMIC_FILTER_CSV, index=False)\n",
    "print(f\"Saved task3 phonemic filter excluded rows: {OUTPUT_TASK3_PHONEMIC_FILTER_CSV.resolve()}\")"
   ]
